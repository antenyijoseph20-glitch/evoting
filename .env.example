# Copy to .env and edit. Never commit .env (it is gitignored).

# development | production
EVOTING_ENV=development

# --- Storage (host paths; docker-compose overrides these inside the container) ---
EVOTING_DB=evoting.db
# Production: path to the election authority Ed25519 private key (PKCS8 PEM).
# Generate it offline and keep it on encrypted, access-controlled storage.
#   python3 manage.py authority-keygen --out /secure/authority_ed25519.key
# In development, a key is created automatically at this path if missing.
EVOTING_AUTHORITY_KEY=authority_ed25519.key

# Keyed hash secret for NIN/VIN and OTP binding. REQUIRED in production
# (minimum 32 characters; the generator below produces 64).
# Generate: python3 manage.py hmac-keygen
EVOTING_HMAC_SECRET=

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For and is the
# only route to the app; otherwise clients could spoof their rate-limit IP.
EVOTING_TRUST_PROXY=0

# --- SMS gateway (generic JSON webhook) ---
# The app POSTs {"to","message","sender"} and expects any 2xx.
# Required in production; in development the OTP is printed to the console.
EVOTING_SMS_GATEWAY_URL=
EVOTING_SMS_API_KEY=
EVOTING_SMS_AUTH_HEADER=Authorization
EVOTING_SMS_AUTH_SCHEME=Bearer
EVOTING_SMS_SENDER=E2E-V
EVOTING_SMS_TIMEOUT_S=10
EVOTING_SMS_RETRIES=2
EVOTING_SMS_TEMPLATE=Your E2E-V code is {otp}. It expires in {minutes} minutes. Never share it.

# --- Biometrics ---
# The built-in development check only detects that one face is present.
# Production requires an operator-supplied matcher in the form
# "package.module:callable" that accepts image bytes and returns True only for
# an enrolled match with a liveness check. Startup is refused otherwise.
EVOTING_FACE_MATCHER=

# --- Docker only ---
# Bind address on the host. Keep 127.0.0.1 behind a TLS reverse proxy.
EVOTING_BIND=127.0.0.1
